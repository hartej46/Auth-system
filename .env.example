# Server Configuration
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database
CONNECTION_STRING=postgresql://username:password@localhost:5432/auth_db
DB_SSL=false

# Redis Configuration (For staging unverified registrations & OTP caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# JWT Secrets & Expiry
ACCESS_TOKEN_GENERATOR=your_super_secret_access_token_key_here
REFRESH_TOKEN_GENERATOR=your_super_secret_refresh_token_key_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# SMTP Configuration (For Email OTP and Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
APP_NAME=Auth System
