{
  "name": "auth-system",
  "version": "1.0.0",
  "description": "Generic, plug-and-play email-based authentication system using Express, TypeScript, PostgreSQL, Redis, and JWT",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "auth",
    "authentication",
    "jwt",
    "postgresql",
    "redis",
    "express",
    "typescript"
  ],
  "author": "Hartejsingh Sandhu",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-useragent": "^2.2.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-useragent": "^1.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
